# Copy this file to .env for local testing (Railway sets these for you in production).

# Get this from console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Railway provides this automatically once you add a Postgres plugin.
# For local testing, point it at a local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/winecellar

# Any long random string — used to sign login sessions.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the backend listens on (Railway sets this automatically too)
PORT=3001
